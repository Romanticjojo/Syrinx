  "cards": [
    {
      "dot": "emerald",
      "title": "主数据链路",
      "items": [
        "Song Pack 五件套是一切数据源头，manifest 声明资产与主题色",
        "谱面与伴奏锚点在解析阶段汇成同一条演奏时间轴",
        "音频引擎输出实际播放位置，光标与录音共享谱面时间"
      ]
    },
    {
      "dot": "rose",
      "title": "演奏与分析",
      "items": [
        "光标驱动走 rAF 直写 DOM，不进响应式 store，避免重渲染抖动",
        "录音与分析同源（AudioWorklet 直采），保证音准统计可信",
        "录后音高分析在 Worker 中运行；支持进度反馈与取消"
      ]
    },
    {
      "dot": "orange",
      "title": "反馈闭环",
      "items": [
        "YIN 实测音高 × 谱面目标音高 → 命中 / 偏音 / 漏音三态图表",
        "录音 WAV 与伴奏可在回放页混音对照，双音量独立调节",
        "每段保留起点与速度，回放和图表按对应谱面区间对齐"
      ]
    }
  ]
