  "cards": [
    {
      "dot": "emerald",
      "title": "Primary Data Path",
      "items": [
        "The Song Pack five-file bundle is the source of everything; the manifest declares assets and accent color",
        "Score and beat anchors converge into a single play timeline at parse time",
        "The audio engine supplies live position; cursor and takes share score time"
      ]
    },
    {
      "dot": "rose",
      "title": "Playback & Analysis",
      "items": [
        "Cursor is driven by rAF writing DOM directly — no reactive store, no re-render jitter",
        "Recording and analysis share one source (AudioWorklet), keeping intonation stats trustworthy",
        "Post-take pitch analysis runs in a Worker with progress and cancellation"
      ]
    },
    {
      "dot": "orange",
      "title": "Feedback Loop",
      "items": [
        "YIN measured pitch × score target pitch → hit / off / missed chart",
        "Take WAV and accompaniment mix in the playback view with independent volumes",
        "Segment start and speed align replay and charts with the matching score interval"
      ]
    }
  ]
