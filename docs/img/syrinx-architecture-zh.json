  "cards": [
    {
      "dot": "emerald",
      "title": "纯前端架构",
      "items": [
        "浏览器内闭环：无后端 API，静态托管 + Web API 即全部运行环境",
        "Vite 构建产物静态部署，Song Pack 即插即用（不入库）",
        "每曲独立强调色与主题，由 Song Pack manifest 声明"
      ]
    },
    {
      "dot": "cyan",
      "title": "播放与录音同步",
      "items": [
        "音频引擎提供实际播放位置，光标与录音按同一谱面时间对齐",
        "播放中跳小节或变速：保留当前录音，四拍倒数后开启新段",
        "每段保存起点与速度；光标由 rAF 更新，避免整页重渲染"
      ]
    },
    {
      "dot": "violet",
      "title": "质量内建",
      "items": [
        "score / audio / pitch / synctune 核心域 Vitest TDD 全绿",
        "YIN 纯 TypeScript 实现，接口化设计可替换 CREPE",
        "缺伴奏音频时 OfflineAudioContext 程序化合成夜曲风格兜底"
      ]
    }
  ]
