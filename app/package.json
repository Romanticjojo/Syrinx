{
  "name": "syrinx",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode desktop",
    "dev:web": "vite --mode web",
    "build": "tsc -b && vite build",
    "build:desktop": "tsc -b && vite build --mode desktop --outDir dist-desktop",
    "test": "vitest run",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "vite",
    "dist": "node scripts/patch-nsis.mjs && npm run build:desktop && electron-builder --win",
    "dist:portable": "node scripts/patch-nsis.mjs && npm run build:desktop && electron-builder --win portable"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "opensheetmusicdisplay": "^2.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.12.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "description": "Syrinx · 长笛演奏辅助——曲谱跟随、伴奏同步、动态背景、录音回放",
  "author": "Romanticjojo",
  "license": "Apache-2.0"
}